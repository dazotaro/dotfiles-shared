# Ghostty — shared between Linux and macOS.
#
# macOS note: Ghostty reads BOTH ~/.config/ghostty/config and
# ~/Library/Application Support/com.mitchellh.ghostty/config, and the
# Application Support one is loaded AFTER this file, so it WINS. If Ghostty
# created one on first launch, delete it or this file is silently ignored.

# Font
font-family = JetBrainsMono Nerd Font
font-size = 10.5

# Appearance
theme = Catppuccin Mocha
term = xterm-256color
background-opacity = 0.98

# Window padding — no side padding
window-padding-x = 0
window-padding-y = 2

# Title bar. Each key is recognised only on its own platform and ignored on the
# other, so both can live here.
# Linux/GTK — remove title bar
gtk-titlebar = false
# macOS — native tabs in the title bar
macos-titlebar-style = tabs

# The split and pane bindings below deliberately override Ghostty's defaults
# (which are ctrl+shift+o / ctrl+shift+e for splits and ctrl+alt+arrow for
# navigation) to keep long-standing muscle memory.

# Splits
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down

# Pane navigation — ctrl+shift+arrow
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down

# Pane resize — ctrl+shift+alt+arrow
keybind = ctrl+shift+alt+arrow_left=resize_split:left,5
keybind = ctrl+shift+alt+arrow_right=resize_split:right,5
keybind = ctrl+shift+alt+arrow_up=resize_split:up,5
keybind = ctrl+shift+alt+arrow_down=resize_split:down,5

# Pane management
keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+z=toggle_split_zoom

# Copy/paste — Linux-style, stated explicitly so the chord is identical on both
# platforms. On Linux this is already the default, so it is a no-op there. On
# macOS it ADDS to Cmd+C/Cmd+V rather than replacing them, so both work.
#
# This is the one place worth making cross-platform. System-wide, macOS keeps
# Cmd for app shortcuts and leaves Ctrl entirely to the shell — which is why
# Ctrl+C can always mean SIGINT here and never has to fight "copy". Do not
# remap Ctrl globally to chase Linux parity; fix it in the terminal instead,
# which is where the muscle memory actually lives.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# ---------------------------------------------------------------------------
# Per-machine overrides. The "?" prefix means "skip silently if absent", and
# config-file directives are processed at end-of-file, so anything in the local
# file WINS over the settings above.
#
# On the Mac you will almost certainly want a larger font-size here — 10.5 is
# tuned for Linux fractional scaling and reads tiny on a Retina panel. Also the
# place for `command = /opt/homebrew/bin/bash -l` to get Homebrew's bash 5
# without touching /etc/shells or running chsh.
config-file = ?config.local
