# =============================================================================
# THIS REPO IS PUBLIC. Everything below is a second line of defence, not the
# first. The first is: nothing identifying, machine-specific, or secret gets
# added in the first place. See README.md § What must never land here.
# =============================================================================

# Local, per-machine overrides — the escape hatch these configs point at
.bashrc.local
*.local
config.local

# Secrets of every shape
.env
.env.*
.secrets
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
authorized_keys
**/credentials
*_token
*.token
.netrc
.git-credentials

# Identity-bearing config that belongs in the private repo
git/
ssh/
aws/
claude/
# Claude Code project dir (ephemeral worktrees, settings.local.json)
.claude/
.beads/
.dolt/

# Shell history, ever
*_history
.bash_history

# Neovim: plugin lockfile churns per machine; caches and local state
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/.claude/
nvim/.config/nvim/.neoconf.local.json

# Editor backups
*~
*.swp
*.swo
.*.swp

# OS files
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Python bytecode
__pycache__/
*.py[cod]
